{
  // 牽關：API（Hono）+ 靜態資產（web/dist）同網域分流，規格 §1/§9
  "name": "qianguan",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qianguan",
      "database_id": "a678bffa-97bd-4b8e-b234-8902dda18de1",
      "migrations_dir": "drizzle"
    }
  ],
  // §6.4 速率限制：Turnstile 只掛在建立/加入/發起牽線；貼碼救援端點（owner-session／c/:id/session）
  // 刻意不掛 Turnstile（規格 §6.6：不對權杖驗證加驗證碼），靠這個 IP 節流頂著。
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SITE_NAME": "牽關"
  }
  // Secrets（wrangler secret put）：TURNSTILE_SECRET
}
