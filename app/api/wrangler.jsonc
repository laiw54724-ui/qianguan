{
  // 牽關：API（Hono）+ 靜態資產（web/dist）同網域分流，規格 §1/§9
  "name": "qianguan",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qianguan",
      "database_id": "a678bffa-97bd-4b8e-b234-8902dda18de1",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_STATE",
      "id": "0b68d4fdeb9b4ed283f87dcbb1b9ccd7"
    }
  ],
  // §6.4 速率限制：RATE_LIMITER 是全站 IP 節流；DISCORD_RATE_LIMITER 另外掛在建企劃／加入／
  // 發起牽線，鍵值是 discord_id，取代已移除的 Turnstile 當作濫用防線。
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "DISCORD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SITE_NAME": "牽關",
    "DISCORD_CLIENT_ID": "1544912164756656190"
  }
  // Secrets（wrangler secret put）：TURNSTILE_SECRET, DISCORD_CLIENT_SECRET
}
